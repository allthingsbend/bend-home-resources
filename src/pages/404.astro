---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Bend Home Resources" description="The Bend Home Resources page you requested could not be found." noindex={true}>
  <section class="hero">
    <div class="narrow">
      <p class="eyebrow">404</p>
      <h1>That page moved, never existed, or took a wrong turn.</h1>
      <p class="lead">Use one of the main resource hubs to get back on track.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="/">Go home</a><a class="btn btn-secondary" href="/buying">Buying guides</a></div>
    </div>
  </section>
</BaseLayout>
