---
import HubPage from '../../components/HubPage.astro';
import { getHubEntries } from '../../lib/content';

export async function getStaticPaths() {
  const hubs = await getHubEntries();
  return hubs.map((hub) => ({ params: { section: hub.id }, props: { section: hub.id } }));
}

interface Props { section: string }
const { section } = Astro.props;
---
<HubPage section={section} />
