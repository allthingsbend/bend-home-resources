---
import ResourcePage from '../../components/ResourcePage.astro';
import { getPages } from '../../lib/content';

export async function getStaticPaths() {
  const pages = await getPages();
  return pages.map((entry) => ({
    params: { section: entry.data.section as string, slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---
<ResourcePage entry={entry} />
